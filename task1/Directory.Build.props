<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Version>1.0.0</Version>
    <Authors>WukongBench</Authors>
    <Product>Black Myth: Wukong Benchmark Automation</Product>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- CA1416: Windows-only platform checks. The Infrastructure/Presentation
         layers are intentionally Windows-only (they automate a Windows game). -->
  </PropertyGroup>

</Project>
