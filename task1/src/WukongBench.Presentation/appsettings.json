{
  // Every value below can also be overridden on the command line (see --help)
  // or with environment variables named WUKONGBENCH_<Path>__<To>__<Key>.
  "WukongBench": {
    "SteamAppId": 3132990,
    // "ExecutablePathOverride": "D:\\SteamLibrary\\steamapps\\common\\Black Myth Wukong Benchmark Tool\\b1_benchmark.exe",
    // "SteamRootOverride": "C:\\Program Files (x86)\\Steam",
    "LaunchThroughSteam": true,
    "UseHighPerformancePowerScheme": true,
    "ArtifactsDirectory": "artifacts",
    "ToolName": "wukongbench",
    "ToolVersion": "1.0.0",

    "Timings": {
      "LaunchTimeoutSeconds": 240,
      "MainMenuSettleSeconds": 40,
      "BenchmarkCompletionTimeoutSeconds": 900,
      "ResultPollIntervalSeconds": 5,
      "ResultSettleSeconds": 8,
      "ProcessExitTimeoutSeconds": 60,
      "ProcessKillGraceSeconds": 15
    },

    // CPU pass: everything is stripped down so the processor is the bottleneck.
    "CpuScenario": {
      "Enabled": true,
      "ResolutionWidth": 1280,
      "ResolutionHeight": 720,
      "ResolutionQualityPercent": 25,
      "WindowMode": "Windowed",
      "Quality": "Low",
      "Upscaling": "Off",
      "UpscalingQuality": "UltraPerformance",
      "FrameGeneration": "Off",
      "RayTracing": "Off",
      "VSync": false,
      "FrameRateLimit": 0,
      "MotionBlur": false,
      "ExtraSettings": [],
      "ExtraUiSettings": [],
      "ExtraLaunchArguments": []
    },

    // GPU pass: native resolution, everything at maximum, ray tracing at Ultra.
    "GpuScenario": {
      "Enabled": true,
      "UseNativeResolution": true,
      "ResolutionWidth": 3840,
      "ResolutionHeight": 2160,
      "ResolutionQualityPercent": 100,
      "WindowMode": "Fullscreen",
      "Quality": "Cinematic",
      "Upscaling": "Tsr",
      "UpscalingQuality": "Dlaa",
      "FrameGeneration": "Off",
      "RayTracing": "Ultra",
      "VSync": false,
      "FrameRateLimit": 0,
      "MotionBlur": false,
      "ForceDirectX12": true,
      "ExtraSettings": [],
      "ExtraUiSettings": [],
      "ExtraLaunchArguments": []
    },

    // Input synthesis. The benchmark tool's main menu ignores the keyboard until
    // the mouse hovers it, therefore the first step is a mouse move + click.
    "UiAutomation": {
      "Enabled": true,
      "StartScript": [
        { "Action": "MouseMoveAndClick", "NormalizedX": 0.5, "NormalizedY": 0.5, "HoldMilliseconds": 60, "DelayAfterMilliseconds": 2500, "Description": "Hover/click the centre of the main menu so the UI accepts input" },
        { "Action": "KeyPress", "Key": "Enter", "HoldMilliseconds": 60, "DelayAfterMilliseconds": 2500, "Description": "Confirm the pre-selected 'Benchmark Test' entry" },
        { "Action": "KeyPress", "Key": "Enter", "HoldMilliseconds": 60, "DelayAfterMilliseconds": 2500, "Description": "Confirm the start dialog" },
        { "Action": "Wait", "DelayAfterMilliseconds": 1500, "Description": "Hand control back to the benchmark" }
      ],
      "ExitScript": [
        { "Action": "KeyPress", "Key": "Escape", "HoldMilliseconds": 60, "DelayAfterMilliseconds": 1500, "Description": "Leave the results screen" }
      ]
    }
  }
}
