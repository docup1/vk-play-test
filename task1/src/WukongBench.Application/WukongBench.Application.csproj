<Project Sdk="Microsoft.NET.Sdk">

  <!--
    APPLICATION LAYER
    =================
    Use cases / orchestration. Depends ONLY on the Domain layer
    (it consumes the Domain ports and produces Domain models).
    It must never reference the Infrastructure layer.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>WukongBench.Application</RootNamespace>
    <AssemblyName>WukongBench.Application</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WukongBench.Domain\WukongBench.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.0" />
  </ItemGroup>

</Project>
